{
  "name": "note-cli",
  "version": "0.1.0",
  "description": "Unofficial note.com CLI for drafting, searching and analyzing articles (for Claude Code / Codex)",
  "type": "module",
  "license": "MIT",
  "bin": {
    "note-cli": "dist/note-cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/bin.ts --bundle --platform=node --format=esm --target=node22 --banner:js='#!/usr/bin/env node' --outfile=dist/note-cli.js && chmod +x dist/note-cli.js",
    "dev": "node src/bin.ts",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build && git diff --exit-code -- dist"
  },
  "files": [
    "dist",
    "skills",
    ".claude-plugin",
    ".codex-plugin",
    ".agents"
  ],
  "dependencies": {
    "marked": "^18.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
