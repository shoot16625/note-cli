{
  "name": "note-cli",
  "version": "0.1.0",
  "description": "Unofficial note.com CLI for drafting, searching and analyzing articles (for Claude Code / Codex)",
  "type": "module",
  "license": "MIT",
  "bin": {
    "note-cli": "dist/note-cli.js"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "build": "bun build src/bin.ts --target=bun --outfile=dist/note-cli.js && chmod +x dist/note-cli.js",
    "dev": "bun src/bin.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test && bun run build && git diff --exit-code -- dist"
  },
  "files": [
    "dist",
    "skills",
    ".claude-plugin",
    ".codex-plugin",
    ".agents"
  ],
  "dependencies": {
    "marked": "^18.1.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
